{
  "name": "nexora-main",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "build:next": "next build",
    "deploy": "npm run build && wrangler deploy",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:contracts": "node --test tests/auth-config-contract.test.mjs tests/booking-role-guard.test.mjs tests/business-rules-contract.test.mjs tests/proposal-flow-contract.test.mjs tests/phase1-customer-contract.test.mjs tests/path-routing-contract.test.mjs tests/phase2-owner-package-contract.test.mjs tests/phase3-growth-partner-package-contract.test.mjs tests/phase7-contract.test.mjs tests/phase8-contract.test.mjs tests/full-website-test.mjs tests/production-auth-security-contract.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "test:phase14": "npm run test:phase14:contracts && npm run test:phase14:integration",
    "test:phase14:contracts": "node --test tests/phase14/contracts/*.test.mjs",
    "test:phase14:integration": "node --test tests/phase14/integration/*.test.mjs",
    "test:phase14:e2e": "echo \"E2E requires Playwright\" && exit 0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.95.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Nexora Main Website"
}