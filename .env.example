# Nexora Main Website - Environment Variables
# Copy this file to .env.local or set these in your hosting environment (e.g., Vercel)
# NOTE: These are EXAMPLE values. Replace with real credentials for production.

# Supabase Configuration (Required for build)
# Shared project: qwaehqsmodekbgvnaavz
NEXT_PUBLIC_SUPABASE_URL=https://qwaehqsmodekbgvnaavz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Integrated Job Portal browser build. The build script automatically falls
# back to the matching NEXT_PUBLIC_* values, so these are optional aliases.
# VITE_SUPABASE_URL=https://qwaehqsmodekbgvnaavz.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here
# VITE_APP_BASE_PATH=/job-portal/

# PWA Portal Origins (Optional - configure for reverse proxy)
# NEXORA_CUSTOMER_PWA_ORIGIN=https://custmer-fresh-app.vercel.app
# NEXORA_OWNER_PWA_ORIGIN=https://pink-nexora-aap.vercel.app
# NEXORA_PARTNER_PWA_ORIGIN=https://pink-growth-partner-aap.vercel.app

# Google OAuth (Optional - enable after provider verification)
# NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=true
