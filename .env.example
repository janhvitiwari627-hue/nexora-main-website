# Nexora Main Website - Environment Variables
# Copy this file to .env.local or set these in your hosting environment (e.g., Vercel)
# NOTE: These are EXAMPLE values. Replace with real credentials for production.

# Supabase Configuration (Required for build)
# Shared project: qwaehqsmodekbgvnaavz
NEXT_PUBLIC_SUPABASE_URL=https://qwaehqsmodekbgvnaavz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Vite applications use these names. Root integration build scripts fall back
# to the matching NEXT_PUBLIC_* pair, but explicitly mapping both pairs avoids
# hosting-provider scope mistakes when an app is deployed independently.
VITE_SUPABASE_URL=https://qwaehqsmodekbgvnaavz.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# VITE_APP_BASE_PATH=/job-portal/

# Required external PWA origins (absolute HTTPS origins; no path/query/hash).
# NEXORA_CUSTOMER_PWA_ORIGIN=https://remix-final-salon-app.vercel.app
# NEXORA_OWNER_PWA_ORIGIN=https://owner-pwa.example.com
# NEXORA_PARTNER_PWA_ORIGIN=https://partner-pwa.example.com
# Backward-compatible Partner alias; if both are set they must match exactly.
# GROWTH_PARTNER_APP_ORIGIN=https://partner-pwa.example.com
# Optional: /app/template defaults to the canonical Template App deployment.
# Set this only to point the Template App at a different deployment.
# NEXORA_TEMPLATE_PWA_ORIGIN=https://final-new-app-templete.vercel.app

# Google OAuth (Optional - enable after provider verification)
# NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=true

# ---------------------------------------------------------------------------
# PHASE 1 — Centralized auth (packages/auth)
# ---------------------------------------------------------------------------
# Origins allowed to receive an authenticated redirect (comma-separated).
# This list MUST match Supabase -> Authentication -> URL Configuration ->
# Redirect URLs, or the cross-origin PKCE handoff is refused.
# Defaults cover the current production deployments when unset.
# NEXT_PUBLIC_NEXORA_ALLOWED_AUTH_ORIGINS=https://nexora-main-website.vercel.app,https://remix-final-salon-app.vercel.app,https://final-new-app-templete.vercel.app
