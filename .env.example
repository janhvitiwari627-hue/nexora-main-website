# Nexora Main Website - Environment Variables
# Copy this file to .env.local or set these in your hosting environment (e.g., Vercel)
# NOTE: These are EXAMPLE values. Replace with real credentials for production.

# Supabase Configuration (Required for build)
# Shared project: qwaehqsmodekbgvnaavz
NEXT_PUBLIC_SUPABASE_URL=https://qwaehqsmodekbgvnaavz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Integrated Job Portal browser build. The build script automatically falls
# back to the matching NEXT_PUBLIC_* values, so these are optional aliases.
# VITE_SUPABASE_URL=https://qwaehqsmodekbgvnaavz.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here
# VITE_APP_BASE_PATH=/job-portal/

# PWA Portal Origins (optional overrides). Customer, Owner and Partner fall
# back to the production deployments in app/lib/portalOrigins.ts when unset.
# Template has no production URL and stays env-var-only.
# NEXORA_CUSTOMER_PWA_ORIGIN=https://custmer-fresh-app.vercel.app
# NEXORA_OWNER_PWA_ORIGIN=https://shop-onwer-pink-nexora-aap.vercel.app
# NEXORA_PARTNER_PWA_ORIGIN=https://pink-growth-partner-diamondpeomotion-cybers-projects.vercel.app
# NEXORA_TEMPLATE_PWA_ORIGIN=https://your-template-app.vercel.app

# Google OAuth (Optional - enable after provider verification)
# NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=true

# ---------------------------------------------------------------------------
# PHASE 1 — Centralized auth (packages/auth)
# ---------------------------------------------------------------------------
# Origins allowed to receive an authenticated redirect (comma-separated).
# This list MUST match Supabase -> Authentication -> URL Configuration ->
# Redirect URLs, or the cross-origin PKCE handoff is refused.
# Defaults cover the current production deployments when unset.
# NEXT_PUBLIC_NEXORA_ALLOWED_AUTH_ORIGINS=https://nexora-main-website.vercel.app,https://custmer-fresh-app.vercel.app
