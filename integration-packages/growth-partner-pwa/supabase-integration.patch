+/** Creates the application and delegates payload validation/proposal ownership
+ * to the server RPC. The client never inserts a proposal directly. */
+export async function submitSalonProposal(
+  client: SupabaseClient,
+  partnerId: string,
+  input: SalonProposalInput,
+): Promise<{ applicationId: string; proposalId: string }> {
+  if (!input.services.length) throw new Error('Add at least one service before submitting.');
+  const lowestPrice = Math.min(...input.services.map((service) => service.pricePaise));
+  const { data: application, error: applicationError } = await client
+    .from('shop_onboarding_applications')
+    .insert({
+      submitted_by_partner_id: partnerId,
+      status: 'draft',
+      current_step: 6,
+      owner_email: input.ownerEmail.trim().toLowerCase(),
+      owner_phone: input.ownerPhone.trim(),
+      shop_name: input.shopName.trim(),
+      city: input.city.trim(),
+      locality: input.locality.trim(),
+      full_address: input.address.trim(),
+      opening_time: input.openingTime,
+      closing_time: input.closingTime,
+      starting_price_paise: lowestPrice,
+      about_shop: input.description.trim(),
+      website_template: input.templateKey || 'modern-salon',
+    })
+    .select('id')
+    .single();
+  if (applicationError) throw applicationError;
+
+  const payload = {
+    profile: {
+      name: input.shopName.trim(),
+      description: input.description.trim(),
+      phone: input.ownerPhone.trim(),
+      email: input.ownerEmail.trim().toLowerCase(),
+      address: input.address.trim(),
+      area: input.locality.trim(),
+      city: input.city.trim(),
+      business_category: input.category.trim(),
+      logo_url: input.logoUrl?.trim() || '',
+      cover_url: input.coverUrl?.trim() || '',
+      starting_price_paise: lowestPrice,
+      opening_hours: { opens: input.openingTime, closes: input.closingTime },
+    },
+    services: input.services.map((service) => ({
+      name: service.name.trim(),
+      description: service.description?.trim() || '',
+      price_paise: Math.round(service.pricePaise),
+      duration_minutes: Math.max(1, Math.round(service.durationMinutes)),
+    })),
+    staff: [],
+    photos: input.coverUrl?.trim() ? [{ url: input.coverUrl.trim(), title: `${input.shopName.trim()} cover`, is_cover: true }] : [],
+    offers: [],
+    template: { key: input.templateKey || 'modern-salon' },
+  };
+  const { data: proposalId, error: proposalError } = await client.rpc('save_growth_partner_salon_setup', {
+    p_application_id: application.id,
+    p_payload: payload,
+    p_submit: true,
+  });
+  if (proposalError) throw proposalError;
+  return { applicationId: application.id, proposalId: String(oneRow(proposalId) ?? proposalId) };
+}
