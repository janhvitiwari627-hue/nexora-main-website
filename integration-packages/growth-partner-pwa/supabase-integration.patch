+import React, { useCallback, useEffect, useState } from 'react';
+import { ArrowLeft, RefreshCw, Store } from 'lucide-react';
+import { supabase } from '../../lib/supabaseClient';
+import { ensureGrowthPartnerIdentity, fetchMyAttributions, GpAttribution } from '../../lib/gpRepository';
+
+type Props = { onBack: () => void; onNavigate?: (page: string) => void };
+export default function MyShopsScreen({ onBack, onNavigate }: Props) {
+  const [shops, setShops] = useState<GpAttribution[]>([]); const [loading, setLoading] = useState(true); const [error, setError] = useState('');
+  const load = useCallback(async () => { if (!supabase) return; setLoading(true); setError(''); try { const partner = await ensureGrowthPartnerIdentity(supabase); setShops(await fetchMyAttributions(supabase, partner.id)); } catch (e: any) { setError(e?.message || 'Could not load attributions.'); setShops([]); } finally { setLoading(false); } }, []);
+  useEffect(() => { void load(); }, [load]);
+  return <main className="min-h-screen bg-[#fcf9f8] pb-24"><header className="sticky top-0 z-20 bg-white/95 backdrop-blur border-b border-gray-100 px-5 py-4 flex items-center justify-between"><div className="flex items-center gap-3"><button onClick={onBack} className="p-2 rounded-xl bg-gray-100"><ArrowLeft size={18} /></button><h1 className="text-lg font-black">My attributed shops</h1></div><button onClick={() => void load()} aria-label="Refresh" className="p-2 rounded-xl bg-gray-100 text-pink-700"><RefreshCw className={loading ? 'w-4 h-4 animate-spin' : 'w-4 h-4'} /></button></header><main className="max-w-2xl mx-auto p-5 space-y-4">{loading && <p className="text-sm text-gray-500">Loading live attribution rows…</p>}{error && <p className="rounded-xl bg-rose-50 p-4 text-sm text-rose-800">{error}</p>}{!loading && !error && shops.length === 0 && <div className="rounded-2xl bg-white border border-gray-100 p-6 text-center"><Store className="mx-auto text-gray-400" /><h2 className="font-bold mt-3">No attributed shops yet</h2><p className="text-sm text-gray-500 mt-2">Submit a shop proposal to create the server-side attribution workflow.</p><button onClick={() => onNavigate?.('add-shop')} className="mt-4 rounded-xl bg-pink-700 px-4 py-3 text-white font-bold">Add shop proposal</button></div>}{shops.map((shop) => <article key={shop.id} className="rounded-2xl bg-white border border-gray-100 p-5"><div className="flex items-start justify-between gap-3"><div><h2 className="font-bold">{shop.salon_name || `Salon ${shop.salon_id.slice(0, 8)}`}</h2><p className="text-sm text-gray-500 mt-1">{shop.salon_area || 'Area unavailable'} · {shop.salon_city || 'City unavailable'}</p></div><span className="text-xs font-bold text-pink-700">{shop.status}</span></div><p className="text-xs text-gray-500 mt-4">Attribution: {shop.attribution_method || 'server record'} · Effective: {shop.effective_from ? new Date(shop.effective_from).toLocaleDateString('en-IN') : '—'}</p></article>)}</main></main>;
 }
