ed-xl border border-gray-200 p-3 font-normal" /></label><Field label="Cover image URL (optional)" value={coverUrl} onChange={setCoverUrl} /></Section><Section title="Services"><div className="space-y-3">{services.map((service, index) => <div key={index} className="grid grid-cols-1 sm:grid-cols-[2fr_1fr_1fr_auto] gap-2 items-end"><Field label="Name" value={service.name} onChange={(value) => updateService(setServices, index, { name: value })} required /><Field label="Price ₹" type="number" value={service.price} onChange={(value) => updateService(setServices, index, { price: value })} required /><Field label="Minutes" type="number" value={service.duration} onChange={(value) => updateService(setServices, index, { duration: value })} required /><button type="button" onClick={() => setServices((current) => current.filter((_, itemIndex) => itemIndex !== index))} disabled={services.length === 1} className="p-3 text-rose-600 disabled:opacity-30"><Trash2 size={18} /></button></div>)}</div><button type="button" onClick={() => setServices((current) => [...current, blankService()])} className="text-sm font-bold text-pink-700 flex items-center gap-2"><Plus size={16} /> Add service</button></Section>{message && <div className="rounded-xl bg-white border border-gray-200 p-4 text-sm" role="status">{message}</div>}<button disabled={busy || !partnerCode} className="w-full rounded-2xl bg-pink-700 text-white py-4 font-black disabled:opacity-50">{busy ? 'Submitting to Supabase…' : 'Submit proposal for Owner review'}</button></form></main>;
