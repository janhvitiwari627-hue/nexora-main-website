+
+/**
+ * Phase 6 — canonical Owner-workspace access gate.
+ *
+ * Re-verifies the authenticated session against the shared `business_user`
+ * role and the server-side `owner_salon_ids()` helper, then returns the
+ * canonical Nexora access record. This is the single entry point the rest
+ * of the app should use for "is the current user a real Shop Owner with at
+ * least one salon?" decisions; it fails closed on every error.
+ *
+ * Falls back to the hand-rolled `resolveOwnerSalonId()` chain (helper →
+ * membership → salon join → visibility probe) when the canonical helper is
+ * not exposed by the current database, so the gate never silently regresses
+ * to a wrong answer on older deployments.
+ */
+export async function requireOwnerWorkspaceAccess(): Promise<{
+  access: OwnerWorkspaceAccess | null;
+  resolution: OwnerSalonResolution;
+}> {
+  if (!supabase) {
+    return { access: null, resolution: { status: 'not-configured' } };
+  }
+  try {
+    const access = await requireOwnerWorkspace(supabase);
+    const resolution: OwnerSalonResolution =
+      access.salonIds.length === 0
+        ? { status: 'no-membership' }
+        : access.salonIds.length === 1
+          ? { status: 'resolved', salonId: access.salonIds[0] }
+          : { status: 'ambiguous' };
+    return { access, resolution };
+  } catch {
+    // The canonical gate refused (anonymous, wrong role, etc.). Fall back to
+    // the hand-rolled resolution so the caller can still surface the right
+    // operator-facing message.
+    const resolution = await resolveOwnerSalonId();
+    return { access: null, resolution };
+  }
+}
