# Browser/public configuration (PHASE 10 parity: the client is pinned to the
# shared Nexora project and rejects any other URL or a service-role key).
VITE_SUPABASE_URL=https://qwaehqsmodekbgvnaavz.supabase.co
VITE_SUPABASE_ANON_KEY=<PROJECT_ANON_KEY>
VITE_GOOGLE_OAUTH_ENABLED=false

# Server-only Supabase configuration (Vercel serverless functions ONLY —
# framework convention preserved). Never prefix the service-role key with
# VITE_ and never commit a real value; set it in the hosting dashboard.
SUPABASE_URL=https://qwaehqsmodekbgvnaavz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Razorpay configuration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Comma-separated deployment origins allowed to call APIs cross-origin.
# Same-origin requests are allowed automatically.
APP_ORIGIN=http://localhost:3000
ALLOWED_API_ORIGINS=http://localhost:3000

# Optional server integrations
GEMINI_API_KEY=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_APP_IDENTIFIER=NexoraSalonWebsiteBuilder/1.0
NOMINATIM_REFERER=http://localhost:3000
