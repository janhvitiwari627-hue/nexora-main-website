+// Shared owner context hook — resolves the signed-in owner and their salon(s)
+// once, so screens can read/write live Supabase data instead of localStorage.
+
+import { useCallback, useEffect, useState } from 'react';
+import { supabase } from './supabase';
+import { resolveOwnerSalons, OwnerSalon } from './ownerRepository';
+
+export interface OwnerContext {
+  ready: boolean;
+  userId: string | null;
+  salons: OwnerSalon[];
+  /** Primary salon (first owned) or null. */
+  salon: OwnerSalon | null;
+  error: string;
+  reload: () => Promise<void>;
+}
+
+export function useOwnerContext(): OwnerContext {
+  const [ready, setReady] = useState(false);
+  const [userId, setUserId] = useState<string | null>(null);
+  const [salons, setSalons] = useState<OwnerSalon[]>([]);
+  const [error, setError] = useState('');
+
+  const reload = useCallback(async () => {
+    if (!supabase) {
+      setError('Supabase is not configured.');
+      setReady(true);
+      return;
+    }
+    try {
+      const { data } = await supabase.auth.getUser();
+      const user = data.user;
+      if (!user) {
+        setUserId(null);
+        setSalons([]);
+        setReady(true);
+        return;
+      }
+      setUserId(user.id);
+      const rows = await resolveOwnerSalons(supabase, user.id);
+      setSalons(rows);
+      setError('');
+    } catch (cause: any) {
+      setError(cause?.message || 'Could not load your shop.');
+    } finally {
+      setReady(true);
+    }
+  }, []);
+
+  useEffect(() => {
+    void reload();
+  }, [reload]);
+
+  return { ready, userId, salons, salon: salons[0] ?? null, error, reload };
+}
