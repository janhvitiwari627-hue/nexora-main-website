@@ -0,0 +1,303 @@
+import React, { useCallback, useEffect, useMemo, useState } from 'react';
+import Layout from '../components/Layout';
+import { NavigationProps } from '../types';
+import { supabase } from '../lib/supabase';
+import {
+  fetchOwnerProposals,
+  resolveOwnerSalons,
+  reviewProposal,
+  ProposalAction,
+  SetupProposal,
+} from '../lib/ownerRepository';
+import { CheckCircle2, XCircle, Clock, Send, Eye, MessageSquareWarning, RefreshCw } from 'lucide-react';
+
+// Owner Proposal Review — website setup proposals prepared by the Growth
+// Partner / onboarding flow. The owner reviews the payload and decides:
+// approve / request changes / reject / publish (review_salon_setup RPC).
+// Publishing is what makes the shop visible in the Customer PWA & website.
+
+type StatusStyle = { label: string; classes: string };
+
+const STATUS_META: Record<string, StatusStyle> = {
+  submitted: { label: 'Awaiting review', classes: 'bg-amber-50 text-amber-700 border-amber-200' },
+  approved: { label: 'Approved', classes: 'bg-blue-50 text-blue-700 border-blue-200' },
+  changes_requested: { label: 'Changes requested', classes: 'bg-orange-50 text-orange-700 border-orange-200' },
+  edit_requested: { label: 'Edit requested', classes: 'bg-orange-50 text-orange-700 border-orange-200' },
+  published: { label: 'Published', classes: 'bg-emerald-50 text-emerald-700 border-emerald-200' },
+  rejected: { label: 'Rejected', classes: 'bg-rose-50 text-rose-700 border-rose-200' },
+};
+
+const formatDate = (iso: string | null): string => {
+  if (!iso) return '—';
+  const d = new Date(iso);
+  if (Number.isNaN(d.getTime())) return iso;
+  return d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) +
+    ', ' + d.toLocaleTimeString('en-IN', { hour: 'numeric', minute: '2-digit' });
+};
+
+const payloadSummary = (payload: Record<string, unknown> | null) => {
+  const p = (payload ?? {}) as Record<string, any>;
+  const salon = (p.salon ?? p.shop ?? {}) as Record<string, any>;
+  const services = Array.isArray(p.services) ? p.services : [];
+  const staff = Array.isArray(p.staff) ? p.staff : [];
+  return {
+    name: salon.name || p.name || 'Website setup',
+    category: salon.business_category || p.business_category || '',
+    city: salon.city || p.city || '',
+    serviceCount: services.length,
+    staffCount: staff.length,
+  };
+};
+
+export default function ProposalReview({ navigate }: NavigationProps) {
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState('');
+  const [proposals, setProposals] = useState<SetupProposal[]>([]);
+  const [salonNames, setSalonNames] = useState<Record<string, string>>({});
+  const [selected, setSelected] = useState<SetupProposal | null>(null);
+  const [notes, setNotes] = useState('');
+  const [busyAction, setBusyAction] = useState<ProposalAction | null>(null);
+  const [toast, setToast] = useState<string | null>(null);
+
+  const showToast = (msg: string) => {
+    setToast(msg);
+    window.setTimeout(() => setToast(null), 4000);
+  };
+
+  const load = useCallback(async () => {
+    if (!supabase) {
+      setError('Supabase is not configured.');
+      setLoading(false);
+      return;
+    }
+    setLoading(true);
+    setError('');
+    try {
+      const { data } = await supabase.auth.getUser();
+      const user = data.user;
+      if (!user) throw new Error('Not authenticated');
+      const salons = await resolveOwnerSalons(supabase, user.id);
+      const names: Record<string, string> = {};
+      salons.forEach((s) => {
+        names[s.id] = s.name;
+      });
+      setSalonNames(names);
+      const rows = await fetchOwnerProposals(
+        supabase,
+        salons.map((s) => s.id),
+      );
+      setProposals(rows);
+    } catch (cause: any) {
+      setError(cause?.message || 'Could not load proposals.');
+    } finally {
+      setLoading(false);
+    }
+  }, []);
+
+  useEffect(() => {
+    void load();
+  }, [load]);
+
+  const pendingCount = useMemo(
+    () => proposals.filter((p) => p.status === 'submitted' || p.status === 'approved').length,
+    [proposals],
+  );
+
+  const runAction = async (action: ProposalAction) => {
+    if (!supabase || !selected) return;
+    if ((action === 'request_changes' || action === 'reject') && !notes.trim()) {
+      showToast(action === 'request_changes' ? 'Add a note describing the changes needed.' : 'Add a short reason for rejection.');
+      return;
+    }
+    setBusyAction(action);
+    try {
+      await reviewProposal(supabase, selected.id, action, notes);
+      showToast(
+        action === 'publish'
+          ? 'Published! Your shop website is now live for customers.'
+          : action === 'approve'
+            ? 'Proposal approved.'
+            : action === 'request_changes'
+              ? 'Changes requested from the proposer.'
+              : 'Proposal rejected.',
+      );
+      setNotes('');
+      setSelected(null);
+      await load();
+    } catch (cause: any) {
+      showToast(cause?.message || 'Action failed. Please try again.');
+    } finally {
+      setBusyAction(null);
+    }
+  };
+
+  return (
+    <Layout currentScreen="proposal-review" navigate={navigate} title="NEXORA SALONOS" showBack onBack={() => navigate('dashboard')}>
+      <div className="px-4 py-6 max-w-md mx-auto w-full flex flex-col gap-4 min-h-[calc(100vh-120px)]">
+        <div className="flex items-center justify-between">
+          <div>
+            <h2 className="text-[26px] font-bold text-on-surface tracking-tight">Website Proposals</h2>
+            <p className="text-[13px] text-on-surface-variant mt-0.5">
+              Review shop website setups before they go live.
+            </p>
+          </div>
+          <button
+            onClick={() => void load()}
+            className="w-11 h-11 rounded-full bg-surface-container flex items-center justify-center active:scale-90 transition-transform"
+            aria-label="Refresh proposals"
+          >
+            <RefreshCw className={`w-5 h-5 text-primary ${loading ? 'animate-spin' : ''}`} />
+          </button>
+        </div>
+
+        {pendingCount > 0 && (
+          <div className="rounded-2xl bg-primary-container/40 border border-primary/20 p-4 flex items-center gap-3">
+            <Clock className="w-5 h-5 text-primary shrink-0" />
+            <p className="text-[13px] text-on-surface leading-snug">
+              <span className="font-bold">{pendingCount}</span> proposal{pendingCount > 1 ? 's' : ''} waiting
+              for your review. Publishing approves your shop for customer bookings.
+            </p>
+          </div>
+        )}
+
+        {loading && (
+          <div className="flex flex-col items-center justify-center py-20 gap-3">
+            <div className="w-9 h-9 border-[3px] border-primary/20 border-t-primary rounded-full animate-spin" />
+            <p className="text-sm text-on-surface-variant">Loading proposals...</p>
+          </div>
+        )}
+
+        {!loading && error && (
+          <div className="rounded-2xl bg-error-container/40 border border-error/20 p-4 text-[13px] text-on-surface">
+            {error}
+          </div>
+        )}
+
+        {!loading && !error && proposals.length === 0 && (
+          <div className="flex flex-col items-center justify-center py-20 text-center gap-2">
+            <Eye className="w-8 h-8 text-on-surface-variant" />
+            <h3 className="font-bold text-on-surface">No proposals yet</h3>
+            <p className="text-[13px] text-on-surface-variant max-w-[260px]">
+              When your Growth Partner prepares your shop website, it will appear here for review.
+            </p>
+          </div>
+        )}
+
+        {!loading && !error && proposals.map((proposal) => {
+          const meta = STATUS_META[proposal.status] ?? { label: proposal.status, classes: 'bg-slate-50 text-slate-600 border-slate-200' };
+          const summary = payloadSummary(proposal.payload);
+          const isActive = selected?.id === proposal.id;
+          const canDecide = proposal.status === 'submitted' || proposal.status === 'approved';
+          return (
+            <div key={proposal.id} className="rounded-2xl bg-surface-container-lowest border border-outline-variant/50 shadow-sm overflow-hidden">
+              <button
+                onClick={() => {
+                  setSelected(isActive ? null : proposal);
+                  setNotes('');
+                }}
+                className="w-full p-4 text-left active:bg-surface-container-low/60 transition-colors"
+              >
+                <div className="flex items-start justify-between gap-2">
+                  <div className="min-w-0">
+                    <p className="font-bold text-[15px] text-on-surface truncate">{summary.name}</p>
+                    <p className="text-[12px] text-on-surface-variant mt-0.5 truncate">
+                      {salonNames[proposal.salon_id ?? ''] || 'New shop'}
+                      {summary.category ? ` · ${summary.category}` : ''}
+                      {summary.city ? ` · ${summary.city}` : ''}
+                    </p>
+                  </div>
+                  <span className={`shrink-0 px-2.5 py-1 rounded-full border text-[10px] font-bold uppercase tracking-wide ${meta.classes}`}>
+                    {meta.label}
+                  </span>
+                </div>
+                <div className="flex items-center gap-3 mt-2 text-[11px] text-on-surface-variant">
+                  <span>{summary.serviceCount} services</span>
+                  <span>·</span>
+                  <span>{summary.staffCount} staff</span>
+                  <span>·</span>
+                  <span>Updated {formatDate(proposal.updated_at)}</span>
+                </div>
+              </button>
+
+              {isActive && (
+                <div className="border-t border-outline-variant/40 p-4 flex flex-col gap-3 bg-surface-container-low/40">
+                  {proposal.owner_notes && (
+                    <div className="rounded-xl bg-surface-container-lowest border border-outline-variant/40 p-3">
+                      <p className="text-[11px] font-bold text-on-surface-variant uppercase tracking-wide mb-1">Your last note</p>
+                      <p className="text-[13px] text-on-surface">{proposal.owner_notes}</p>
+                    </div>
+                  )}
+
+                  {canDecide && (
+                    <>
+                      <div className="flex flex-col gap-1.5">
+                        <label className="text-[12px] font-bold text-on-surface flex items-center gap-1.5">
+                          <MessageSquareWarning className="w-4 h-4 text-primary" />
+                          Note for the proposer (required for changes / rejection)
+                        </label>
+                        <textarea
+                          value={notes}
+                          onChange={(e) => setNotes(e.target.value)}
+                          rows={2}
+                          placeholder="e.g. Please update the cover photo and pricing for facial services..."
+                          className="w-full rounded-xl bg-surface-container-lowest border border-outline-variant/50 p-3 text-[13px] text-on-surface focus:outline-none focus:border-primary resize-none"
+                        />
+                      </div>
+
+                      <div className="grid grid-cols-2 gap-2">
+                        <button
+                          onClick={() => void runAction('approve')}
+                          disabled={busyAction !== null}
+                          className="h-11 rounded-xl bg-blue-600 text-white text-[13px] font-bold flex items-center justify-center gap-1.5 active:scale-[0.97] transition-transform disabled:opacity-50"
+                        >
+                          <CheckCircle2 className="w-4 h-4" /> {busyAction === 'approve' ? 'Approving...' : 'Approve'}
+                        </button>
+                        <button
+                          onClick={() => void runAction('publish')}
+                          disabled={busyAction !== null}
+                          className="h-11 rounded-xl bg-primary text-on-primary text-[13px] font-bold flex items-center justify-center gap-1.5 active:scale-[0.97] transition-transform disabled:opacity-50"
+                        >
+                          <Send className="w-4 h-4" /> {busyAction === 'publish' ? 'Publishing...' : 'Approve & Publish'}
+                        </button>
+                        <button
+                          onClick={() => void runAction('request_changes')}
+                          disabled={busyAction !== null}
+                          className="h-11 rounded-xl bg-orange-500/90 text-white text-[13px] font-bold flex items-center justify-center gap-1.5 active:scale-[0.97] transition-transform disabled:opacity-50"
+                        >
+                          <Clock className="w-4 h-4" /> {busyAction === 'request_changes' ? 'Sending...' : 'Request Changes'}
+                        </button>
+                        <button
+                          onClick={() => void runAction('reject')}
+                          disabled={busyAction !== null}
+                          className="h-11 rounded-xl bg-rose-600 text-white text-[13px] font-bold flex items-center justify-center gap-1.5 active:scale-[0.97] transition-transform disabled:opacity-50"
+                        >
+                          <XCircle className="w-4 h-4" /> {busyAction === 'reject' ? 'Rejecting...' : 'Reject'}
+                        </button>
+                      </div>
+                      <p className="text-[11px] text-on-surface-variant leading-snug">
+                        Publishing verifies your shop, enables online bookings, and makes the website visible in the
+                        Customer app & main website. Attributions are locked per shop.
+                      </p>
+                    </>
+                  )}
+
+                  {proposal.status === 'published' && (
+                    <p className="text-[12px] text-emerald-700 font-medium">
+                      Published {formatDate(proposal.published_at)} — live for customers.
+                    </p>
+                  )}
+                </div>
+              )}
+            </div>
+          );
+        })}
+      </div>
+
+      {toast && (
+        <div className="fixed bottom-28 left-1/2 -translate-x-1/2 z-50 bg-inverse-surface text-inverse-on-surface px-4 py-3 rounded-xl shadow-lg text-[13px] font-medium max-w-[90%]">
+          {toast}
+        </div>
+      )}
+    </Layout>
+  );
+}
