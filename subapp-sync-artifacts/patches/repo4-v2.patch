+const env = (import.meta as ImportMeta & { env?: Record<string, string | undefined> }).env;
+
+export const MAIN_WEBSITE_LOGIN_URL = 'https://nexora-main-website.vercel.app/';
+export const DEFAULT_NEXORA_STORAGE_KEY = 'nexora.auth.qwaehqsmodekbgvnaavz';
+export const NEXORA_STORAGE_KEY = env?.VITE_SUPABASE_STORAGE_KEY?.trim() || DEFAULT_NEXORA_STORAGE_KEY;
+
+export function redirectToMainWebsiteLogin(reason = 'signed_out') {
+  if (typeof window === 'undefined') return;
+  const url = new URL(MAIN_WEBSITE_LOGIN_URL);
+  url.searchParams.set('source', window.location.origin);
+  url.searchParams.set('reason', reason);
+  url.searchParams.set('next', window.location.href);
+  window.location.assign(url.toString());
+}
