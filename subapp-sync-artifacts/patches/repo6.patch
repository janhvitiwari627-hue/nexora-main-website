diff --git a/src/hooks/useLocationSync.ts b/src/hooks/useLocationSync.ts
new file mode 100644
index 0000000..b8b9377
--- /dev/null
+++ b/src/hooks/useLocationSync.ts
@@ -0,0 +1,95 @@
+import { useEffect } from 'react';
+import type { SupabaseClient } from '@supabase/supabase-js';
+
+type UseLocationSyncOptions = {
+  client: SupabaseClient | null | undefined;
+  userId: string | null | undefined;
+  enabled?: boolean;
+};
+
+const GEO_OPTIONS: PositionOptions = {
+  enableHighAccuracy: true,
+  timeout: 15_000,
+  maximumAge: 0,
+};
+
+async function writeLocation(client: SupabaseClient, userId: string, position: GeolocationPosition) {
+  const capturedAt = new Date(position.timestamp).toISOString();
+  const latitude = position.coords.latitude;
+  const longitude = position.coords.longitude;
+  const accuracy = Number.isFinite(position.coords.accuracy) ? position.coords.accuracy : null;
+  const attempts = [
+    () => client.from('user_locations').upsert({
+      user_id: userId,
+      latitude,
+      longitude,
+      accuracy_m: accuracy,
+      source: 'gps',
+      captured_at: capturedAt,
+      updated_at: capturedAt,
+    }, { onConflict: 'user_id' }),
+    () => client.from('user_locations').upsert({
+      user_id: userId,
+      latitude,
+      longitude,
+      accuracy,
+      updated_at: capturedAt,
+    }, { onConflict: 'user_id' }),
+    () => client.rpc('save_my_private_location', {
+      p_latitude: latitude,
+      p_longitude: longitude,
+      p_accuracy_m: accuracy,
+      p_altitude_m: position.coords.altitude ?? null,
+      p_altitude_accuracy_m: position.coords.altitudeAccuracy ?? null,
+      p_speed_mps: position.coords.speed ?? null,
+      p_heading_degrees: position.coords.heading ?? null,
+      p_captured_at: capturedAt,
+    }),
+  ];
+
+  let lastError: unknown = null;
+  for (const attempt of attempts) {
+    const { error } = await attempt();
+    if (!error) return;
+    lastError = error;
+  }
+  throw lastError instanceof Error ? lastError : new Error(String(lastError || 'Location sync failed.'));
+}
+
+export function useLocationSync({ client, userId, enabled = true }: UseLocationSyncOptions) {
+  useEffect(() => {
+    if (!enabled || !client || !userId) return;
+    if (typeof navigator === 'undefined' || !('geolocation' in navigator)) return;
+
+    let active = true;
+    let lastSignature = '';
+    let saveChain: Promise<void> = Promise.resolve();
+
+    const watchId = navigator.geolocation.watchPosition(
+      (position) => {
+        if (!active) return;
+        const signature = `${userId}:${position.timestamp}:${position.coords.latitude.toFixed(6)}:${position.coords.longitude.toFixed(6)}`;
+        if (signature === lastSignature) return;
+        lastSignature = signature;
+        saveChain = saveChain
+          .catch(() => undefined)
+          .then(async () => {
+            if (!active) return;
+            await writeLocation(client, userId, position);
+          })
+          .catch((error) => {
+            console.warn('[Nexora] location sync skipped:', error);
+          });
+      },
+      (error) => {
+        console.warn('[Nexora] location permission/status:', error.message);
+      },
+      GEO_OPTIONS,
+    );
+
+    return () => {
+      active = false;
+      navigator.geolocation.clearWatch(watchId);
+    };
+  }, [client, enabled, userId]);
+}
diff --git a/src/lib/mainWebsiteAuth.ts b/src/lib/mainWebsiteAuth.ts
new file mode 100644
index 0000000..f9ee6c5
--- /dev/null
+++ b/src/lib/mainWebsiteAuth.ts
@@ -0,0 +1,14 @@
+const env = (import.meta as ImportMeta & { env?: Record<string, string | undefined> }).env;
+
+export const MAIN_WEBSITE_LOGIN_URL = 'https://nexora-main-website.vercel.app/';
+export const DEFAULT_NEXORA_STORAGE_KEY = 'nexora.auth.qwaehqsmodekbgvnaavz';
+export const NEXORA_STORAGE_KEY = env?.VITE_SUPABASE_STORAGE_KEY?.trim() || DEFAULT_NEXORA_STORAGE_KEY;
+
+export function redirectToMainWebsiteLogin(reason = 'signed_out') {
+  if (typeof window === 'undefined') return;
+  const url = new URL(MAIN_WEBSITE_LOGIN_URL);
+  url.searchParams.set('source', window.location.origin);
+  url.searchParams.set('reason', reason);
+  url.searchParams.set('next', window.location.href);
+  window.location.assign(url.toString());
+}
