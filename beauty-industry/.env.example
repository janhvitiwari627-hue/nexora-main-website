# Nexora Luxe — B2B Beauty Marketplace environment parity contract (PHASE 10).
# Copy to .env.local for development. NEVER commit real values to Git.
#
# The build reads these from the process environment too (Vite exposes every
# VITE_* variable present at build time into the browser bundle), so on Vercel
# the shared NEXT_PUBLIC_SUPABASE_* values are picked up automatically. Only
# the public anon key is used — the service_role key must never be committed
# or exposed to the browser.
VITE_SUPABASE_URL=https://qwaehqsmodekbgvnaavz.supabase.co
VITE_SUPABASE_STORAGE_KEY="nexora.auth.qwaehqsmodekbgvnaavz"
VITE_SUPABASE_ANON_KEY=<PROJECT_ANON_KEY>

# NEVER add SUPABASE_SERVICE_ROLE_KEY (or any sb_secret_* key) here. Vite
# inlines every VITE_* variable into the public browser bundle.

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
