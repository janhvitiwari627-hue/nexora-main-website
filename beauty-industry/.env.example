# Distributors Beauty Industry — environment parity contract (PHASE 10).
# Copy to .env.local for development. NEVER commit real values to Git.
#
# NOTE ON AUTH: this app is a static catalog surface. It performs NO direct
# Supabase access — all sign-in/sign-up hands off to the canonical Nexora
# auth routes on the Main Website (/login?returnTo=..., see src/auth.ts) and
# it must never mint its own session. The canonical values below are declared
# for ecosystem parity so any future data feature starts against the one
# shared project; the current build reads neither variable.
VITE_SUPABASE_URL=https://qwaehqsmodekbgvnaavz.supabase.co
VITE_SUPABASE_ANON_KEY=<PROJECT_ANON_KEY>

# NEVER add SUPABASE_SERVICE_ROLE_KEY (or any sb_secret_* key) here. Vite
# inlines every VITE_* variable into the public browser bundle.

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
