# Nexora Jobs (Sub-App) — environment parity contract (PHASE 10).
# Copy to .env.local for development. NEVER commit real values to Git.
#
# The shared Nexora Supabase project is pinned: the canonical client
# (src/lib/supabase.ts) rejects any other project, plain-http URLs,
# malformed keys and service-role keys at startup.

# Supabase project settings (Project Settings -> API)
# The anon/publishable key is safe to expose to the browser when RLS is
# enabled. Paste the project's anon JWT (eyJ...) or publishable key
# (sb_publishable_...).
VITE_SUPABASE_URL=https://qwaehqsmodekbgvnaavz.supabase.co
VITE_SUPABASE_ANON_KEY=<PROJECT_ANON_KEY>

# NEVER add SUPABASE_SERVICE_ROLE_KEY (or any sb_secret_* key) to this app.
# Vite inlines every VITE_* variable into the public browser bundle, and the
# canonical client refuses to start if a service-role key is detected.

# Optional AI feature key. Never place Supabase service_role keys in VITE_* vars.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public URL used for OAuth and password recovery redirects.
APP_URL="http://localhost:3000"
