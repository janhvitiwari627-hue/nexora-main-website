# Phase 14 Acceptance Test Environment Configuration
# Copy to .env.acceptance and fill in real values for live testing
# NEVER commit real credentials to this file or any .env file

# Deployment URL for E2E tests
ACCEPTANCE_BASE_URL=https://nexora-main-website.vercel.app

# Supabase credentials (REQUIRED for integration tests)
NEXT_PUBLIC_SUPABASE_URL=https://qwaehqsmodekbgvnaavz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Test Account Credentials
# Create these test accounts in your Supabase project with these exact emails

# Customer A
ACCEPTANCE_CUSTOMER_A_EMAIL=customer-a-test@example.com
ACCEPTANCE_CUSTOMER_A_PASSWORD=TestPassword123!

# Customer B
ACCEPTANCE_CUSTOMER_B_EMAIL=customer-b-test@example.com
ACCEPTANCE_CUSTOMER_B_PASSWORD=TestPassword123!

# Owner A
ACCEPTANCE_OWNER_A_EMAIL=owner-a-test@example.com
ACCEPTANCE_OWNER_A_PASSWORD=TestPassword123!

# Owner B
ACCEPTANCE_OWNER_B_EMAIL=owner-b-test@example.com
ACCEPTANCE_OWNER_B_PASSWORD=TestPassword123!

# Growth Partner A
